<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConveyorScada.Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <span class="brand">ConveyorScada.Web</span>
        <a href="/">Home</a>
        <div class="scada-clock">
            <b id="clock-time">@(DateTime.Now.ToString("HH:mm:ss"))</b>
            <small id="clock-date">@(DateTime.Now.ToString("dddd, d MMMM yyyy 'р.'", new System.Globalization.CultureInfo("uk-UA")))</small>
        </div>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script>
        setInterval(() => {
            const now = new Date();
            document.getElementById('clock-time').textContent =
                now.toLocaleTimeString('uk-UA');
            document.getElementById('clock-date').textContent =
                now.toLocaleDateString('uk-UA',
                    { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        }, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
