@using ConveyorAutomation.Telemetry
@{
    ViewData["Title"] = "Мнемосхема";
    var uk = new System.Globalization.CultureInfo("uk-UA");
    DateTime today = DateTime.Today;
    DateTime first = new DateTime(today.Year, today.Month, 1);
    int offset = ((int)first.DayOfWeek + 6) % 7;   // початок тижня - понеділок
    int days = DateTime.DaysInMonth(today.Year, today.Month);
}

<h1>Мнемосхема конвеєра</h1>

<div class="scada-page">
<div id="panel">
    <svg id="scheme" class="stopped" viewBox="0 0 840 440" width="840" height="440">
        <rect x="0" y="370" width="840" height="70" fill="#9b7b55" />

        <!-- опори -->
        <g stroke="#555" stroke-width="6">
            <line x1="300" y1="356" x2="300" y2="370" />
            <line x1="500" y1="356" x2="500" y2="370" />
            <line x1="720" y1="356" x2="720" y2="370" />
        </g>

        <!-- стрічка -->
        <rect x="250" y="330" width="520" height="26" rx="13" fill="#3d3d3d" />
        <line class="belt-lines" x1="265" y1="337" x2="755" y2="337" stroke="#f2c230" stroke-width="3" stroke-dasharray="20 20" />
        <circle cx="263" cy="343" r="17" fill="#777" stroke="#444" stroke-width="3" />
        <circle cx="757" cy="343" r="17" fill="#777" stroke="#444" stroke-width="3" />

        <!-- привід -->
        <line x1="230" y1="343" x2="246" y2="343" stroke="#333" stroke-width="5" />
        <rect id="motor" x="150" y="318" width="80" height="52" rx="6" fill="#999" stroke="#333" stroke-width="3" />
        <text x="190" y="351" text-anchor="middle" font-size="18" fill="#fff">M</text>

        <!-- вантажі -->
        <g>
            <rect class="box" style="animation-delay:0s"  x="270" y="294" width="44" height="36" fill="#c98b3c" stroke="#7a4e17" stroke-width="2" />
            <rect class="box" style="animation-delay:-2s" x="270" y="294" width="44" height="36" fill="#c98b3c" stroke="#7a4e17" stroke-width="2" />
            <rect class="box" style="animation-delay:-4s" x="270" y="294" width="44" height="36" fill="#c98b3c" stroke="#7a4e17" stroke-width="2" />
        </g>

        <!-- датчик вантажу на вході -->
        <line x1="292" y1="252" x2="292" y2="290" stroke="#888" stroke-dasharray="4 3" />
        <circle id="cargoLamp" cx="292" cy="244" r="9" fill="#bbb" stroke="#555" />
    </svg>

    <div class="label" style="left:14px; top:14px;">Вхід</div>
    <div class="card" style="left:14px; top:40px;"><div class="t">Вантаж на вході</div><div class="v" id="vCargo">—</div><div class="topic">@ConveyorTopics.InputCargo</div></div>
    <div class="card" style="left:14px; top:138px;"><div class="t">Швидкість стрічки</div><div class="v" id="vSpeed">—</div><div class="topic">@ConveyorTopics.BeltSpeed</div></div>

    <div class="label" style="left:292px; top:14px;">Привід</div>
    <div class="card" style="left:292px; top:40px;"><div class="t">Температура приводу</div><div class="v" id="vTemp">—</div><div class="topic">@ConveyorTopics.MotorTemperature</div></div>
    <div class="card" style="left:292px; top:138px;"><div class="t">Струм приводу</div><div class="v" id="vCurrent">—</div><div class="topic">@ConveyorTopics.MotorCurrent</div></div>

    <div class="label" style="left:570px; top:14px;">Стан</div>
    <div class="card" style="left:570px; top:40px;"><div class="t">Стан конвеєра</div><div class="v" id="vState" style="font-size:1.1rem">—</div><div class="topic">@ConveyorTopics.State</div></div>
    <div class="card" style="left:570px; top:138px;"><div class="t">Оброблено вантажів</div><div class="v" id="vTotal">—</div><div class="topic">@ConveyorTopics.State (totalCargo)</div></div>

    <div id="link">зв'язку немає</div>
</div>

<table class="cal">
    <caption>@uk.TextInfo.ToTitleCase(today.ToString("MMMM yyyy", uk))</caption>
    <tr>
        <th>Пн</th><th>Вт</th><th>Ср</th><th>Чт</th><th>Пт</th><th>Сб</th><th>Нд</th>
    </tr>
    <tr>
        @for (int i = 0; i < offset; i++)
        {
            <td></td>
        }
        @for (int d = 1; d <= days; d++)
        {
            bool isWeekend = (offset + d - 1) % 7 >= 5;
            string css = d == today.Day ? "today" : (isWeekend ? "weekend" : "");
            <td class="@css">@d</td>
            if ((offset + d) % 7 == 0 && d < days)
            {
                @:</tr><tr>
            }
        }
    </tr>
</table>
</div>

<script>
    const T = {
        cargo:   '@ConveyorTopics.InputCargo',
        speed:   '@ConveyorTopics.BeltSpeed',
        temp:    '@ConveyorTopics.MotorTemperature',
        current: '@ConveyorTopics.MotorCurrent'
    };

    const svg = document.getElementById('scheme');
    const lines = svg.querySelector('.belt-lines');
    const boxes = svg.querySelectorAll('.box');
    let lastSpeed = 1;

    function fmt(reading) {
        return reading ? reading.value.toFixed(2) + ' ' + reading.unit : '—';
    }

    function setBeltSpeed(speed) {
        const s = Math.round(speed * 10) / 10;       // округлення, щоб анімація не смикалась від шуму
        const running = s > 0.05;
        svg.classList.toggle('stopped', !running);
        if (running && s !== lastSpeed) {
            lastSpeed = s;
            lines.style.animationDuration = (0.57 / s) + 's';
            boxes.forEach(b => b.style.animationDuration = (6 / s) + 's');
        }
    }

    function render(d) {
        const s = d.sensors || {};

        const cargo = s[T.cargo];
        document.getElementById('vCargo').textContent = cargo ? (cargo.value > 0 ? 'є' : 'немає') : '—';
        document.getElementById('cargoLamp').setAttribute('fill', cargo && cargo.value > 0 ? '#4cc24c' : '#bbb');

        document.getElementById('vSpeed').textContent = fmt(s[T.speed]);
        document.getElementById('vTemp').textContent = fmt(s[T.temp]);
        document.getElementById('vCurrent').textContent = fmt(s[T.current]);
        setBeltSpeed(s[T.speed] ? s[T.speed].value : 0);

        const st = d.state;
        const motor = document.getElementById('motor');
        if (st) {
            document.getElementById('vState').textContent = st.state;
            document.getElementById('vTotal').textContent = st.totalCargo;
            motor.setAttribute('fill', st.emergency ? '#d9534f' : (st.motorRunning ? '#5cb85c' : '#999'));
        }

        // зв'язок є, якщо останній стан не старший за 6 секунд
        const link = document.getElementById('link');
        const age = st ? (new Date(d.serverTimeUtc) - new Date(st.measuredAtUtc)) / 1000 : Infinity;
        const ok = age < 6;
        link.textContent = ok ? 'зв\'язок є' : 'зв\'язку немає';
        link.style.background = ok ? '#4cae4c' : '#999';
        if (!ok) setBeltSpeed(0);
    }

    async function refresh() {
        try {
            const r = await fetch('/Home/Data');
            render(await r.json());
        } catch (e) {
            document.getElementById('link').textContent = 'зв\'язку немає';
        }
    }

    refresh();
    setInterval(refresh, 1000);
</script>
